  "cards": [
    {
      "dot": "cyan",
      "title": "核心引擎（@mastra/core）",
      "items": [
        "Mastra 类是 DI 容器：注册 agents、workflows、tools、memory、storage",
        "Agent 的 agentic loop 编译为内部 workflow，与用户 workflow 共用同一执行引擎",
        "模型字符串（如 openai/gpt-5）由 ModelRouterLanguageModel 解析到具体 provider"
      ]
    },
    {
      "dot": "emerald",
      "title": "接口层",
      "items": [
        "@mastra/server 定义框架无关路由，挂载在 /api，带鉴权与 RBAC",
        "server-adapters 把路由适配到 hono / express / fastify / next 等框架",
        "Studio 与外部前端都通过 @mastra/client-js 调同一套 API"
      ]
    },
    {
      "dot": "violet",
      "title": "扩展与部署",
      "items": [
        "@mastra/mcp：MCPClient 接入外部 MCP 工具，MCPServer 反向暴露 agents",
        "stores/* 提供 20+ 存储与向量库适配，统一实现 MastraStorage 契约",
        "@mastra/deployer 与 deployers/* 构建各平台的部署产物"
      ]
    }
  ]
