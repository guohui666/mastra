  "cards": [
    {
      "dot": "cyan",
      "title": "一次 run 怎么走",
      "items": [
        "importer 只交 item：sourceId、parent、title、body，不写 page 路径",
        "Knowledge 决定每条放在哪，记下哪个 page 来自哪条 item，下次更新而不新增",
        "每批在一个存储事务里和游标一起提交；源系统出错抛 KnowledgeImporterSourceError"
      ]
    },
    {
      "dot": "amber",
      "title": "什么时候发批",
      "items": [
        "攒到 200 条，或最老的一条等了 30 秒",
        "调用 ctx.state.set()，或 import 返回",
        "定时批只带 item，游标只随 ctx.state.set() 前进"
      ]
    },
    {
      "dot": "rose",
      "title": "边界与结果",
      "items": [
        "Knowledge 不调度：同一 binding 同时只跑一个 run，第二个返回 skipped",
        "需要支持事务的存储：@mastra/libsql、@mastra/pg 或内存",
        "结果带 outcome、counts 和 chain；chain 为 true 表示源还没读完，建议接着再跑",
        "晚到的父项和链接在后续批次分批归位（settle）",
        "实验性（alpha），API 可能在版本间变"
      ]
    }
  ]
